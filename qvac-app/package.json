{
  "name": "medpsy-qvac",
  "version": "0.1.0",
  "type": "module",
  "description": "Local-first community-pharmacy triage with ICD-10 RAG grounding, built on the QVAC SDK. Loads medpsy locally, triages a patient, and verifies the ICD-10 code against an on-device index.",
  "license": "MIT",
  "bin": {
    "medpsy-triage": "src/cli.js"
  },
  "scripts": {
    "build-icd-index": "node src/build-index.js",
    "triage": "node src/cli.js",
    "serve": "node src/server.js",
    "serve:qvac": "MEDPSY_BACKEND=qvac node src/server.js",
    "kiosk": "node src/server.js",
    "identity": "node scripts/print_identity.mjs",
    "roster": "node scripts/roster.mjs",
    "agent-eval": "node scripts/agent_eval.mjs",
    "check": "node scripts/preflight.mjs",
    "download-models": "node scripts/preflight.mjs --download",
    "start": "bash scripts/start.sh",
    "start:qvac": "MEDPSY_BACKEND=qvac bash scripts/start.sh",
    "demo:two-kiosk": "bash scripts/demo_two_kiosk.sh"
  },
  "dependencies": {
    "@qvac/factstore": "file:./packages/factstore",
    "@qvac/sdk": "^0.12.2",
    "kokoro-js": "^1.2.1",
    "onnxruntime-node": "^1.26.0"
  },
  "optionalDependencies": {
    "@sqliteai/sqlite-wasm": "*"
  }
}
