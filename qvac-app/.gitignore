# Node
node_modules/
.env
.env.*
!.env.example

# Model weights — NEVER commit GGUFs (multi-GB; live elsewhere on disk, symlinked in)
models/
*.gguf
*.bin
*.safetensors

# Generated ICD-10 embedding index (regenerate with `npm run build-icd-index`)
data/icd10.index.bin
data/icd10.index.meta.json

# data/icd10.json IS committed (small, makes the app self-contained)
audit/

# Device identity — contains the ed25519 SECRET key. Never commit.
data/device-key.json

# Generated knowledge-base chunk index (rebuilds automatically from data/knowledge/)
data/knowledge.index.json

# Bi-temporal fact store (PHI; @qvac/factstore) — on-device, like ./audit
facts/

# OKF (Open Knowledge Format) interchange exports — regenerated on demand
okf/
