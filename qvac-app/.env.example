# Copy to .env (gitignored) and adjust. All optional — defaults work with a running LM Studio.

# Backend: lmstudio (default, dev) | qvac (on-device SDK)
MEDPSY_BACKEND=lmstudio

# --- LM Studio backend ---
LMSTUDIO_URL=http://localhost:1234
MEDPSY_LLM=medpsy-4b
MEDPSY_EMBED=text-embedding-nomic-embed-text-v1.5

# --- QVAC backend ---
# MEDPSY_GGUF=/Users/tex/repos/models/qvac/MedPsy-4B-GGUF/medpsy-4b-q4_k_m-imat.gguf
# MEDPSY_EMBED_GGUF=/path/to/embedding-model.gguf
