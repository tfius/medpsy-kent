# --- Python / uv ---
.venv/
venv/
# also a repo-local .venv symlink (dev convenience; never committed):
.venv
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
build/
dist/
.eggs/

# uv keeps the lockfile (uv.lock) tracked on purpose for reproducible installs;
# only the resolved environment is ignored.

# --- Tooling caches ---
.pytest_cache/
.ruff_cache/
.mypy_cache/
.ipynb_checkpoints/

# --- Secrets / local config ---
.env
.env.*
!.env.example

# --- Editors / OS ---
.vscode/
.idea/
.DS_Store
Thumbs.db
*.swp

# --- Eval outputs ---
# results/ IS committed on purpose: the stored question+answer JSON is the
# research record we grade against, and runs are timestamped so they don't clash.
# If you'd rather keep runs local, uncomment the next line:
# results/

# Scratch dumps produced while reviewing (e.g. /tmp/adv_dump.txt) are never in-repo,
# but ignore any local scratch just in case:
scratch/
*.tmp

# Generated ICD-10 embedding cache (~35MB, regenerate with `uv run icd_lookup.py --build`)
icd_embed_cache.npz
*.npz

# Model weights & node deps (qvac-app) — never commit GGUFs (multi-GB)
*.gguf
node_modules/
qvac-app/models/
qvac-app/data/icd10.index.bin
qvac-app/data/icd10.index.meta.json
qvac-app/audit/
